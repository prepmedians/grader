    {
      "parameters": {
        "jsCode": "const section = $json.section;\nconst column = Number($json.column); // FIX: ensure number\n\nlet expected_count = 10;\n\nif (section === \"english\") {\n  expected_count = 10;\n} else if (section === \"math\") {\n  expected_count = column === 5 ? 5 : 10;\n} else if (section === \"reading\") {\n  expected_count = column === 5 ? 4 : 8;\n} else if (section === \"science\") {\n  expected_count = 8; // all columns are 8\n}\n\nreturn [{\n  json: {\n    ...$json,\n    column, // ensure downstream consistency\n    expected_count\n  },\n  binary: $binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        48
      ],
      "id": "61f22a6e-0b4c-467c-802a-2fc22b658313",
      "name": "Pre"
    },
    {
      "parameters": {
        "jsCode": "// 1. Extract all text from model output\nlet text = $json.content?.map(c => c.text).join(\"\\n\") || \"\";\n\n// 2. Remove markdown fences\ntext = text\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// 3. Try extracting JSON\nconst match = text.match(/\\{[\\s\\S]*\\}/);\n\nif (!match) {\n  return [{\n    json: { ...$json, valid: false },\n    binary: $binary\n  }];\n}\n\ntry {\n  const parsed = JSON.parse(match[0]);\n\n  // 4. Only check basic structure\n  if (!Array.isArray(parsed.answers)) {\n    throw new Error(\"No answers array\");\n  }\n\n  // 5. SUCCESS (no strict checks)\n  return [{\n    json: {\n      ...$json,\n      answers: parsed.answers,\n      valid: true\n    },\n    binary: $binary\n  }];\n\n} catch (e) {\n  return [{\n    json: { ...$json, valid: false },\n    binary: $binary\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
