      "parameters": {
        "jsCode": "const retry = ($json.retry_count || 0) + 1;\n\nif (retry >= 3) {\n  throw new Error(\"Max retries reached\");\n}\n\nreturn [{\n  json: {\n    ...$json,\n    retry_count: retry\n  },\n  binary: $binary\n}];"
      },
